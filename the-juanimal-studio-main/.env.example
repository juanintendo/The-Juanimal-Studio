# Anthropic API key — used server-side by app/api/audit/route.ts
ANTHROPIC_API_KEY=

# Supabase project — Settings → API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Dashboard → Developers → API keys
STRIPE_SECRET_KEY=

# Public site URL, used to build Stripe return URLs (e.g. https://yoursite.com)
NEXT_PUBLIC_SITE_URL=
